define('PDT_PASS',         'TU_PASSWORD_PAGADETODO');
define('PDT_INT_ID',       '125');
define('PDT_BUS_ID_SPEI',  '000002');
define('PDT_BUS_ID_TC',    '000002');

define('DB_HOST', 'localhost');
define('DB_NAME', 'nombre_de_tu_bd');
