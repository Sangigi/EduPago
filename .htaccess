# EduPago — bloquea el acceso web directo a logs y datos sensibles.
# Antes no existía ningún .htaccess: api_log.txt, debug_webhook.txt,
# webhook_log.txt, referencias_log.txt, pagos_spei.json y clabes_alumnos.json
# eran descargables por cualquiera que adivinara la URL (contienen
# referencias de pago, folios, montos, y en el caso de CAI, tokens de
# tarjeta). También bloquea config.php/db.php por si el servidor alguna vez
# sirviera .php como texto plano en vez de ejecutarlo.
#
# ^error_log$ agregado aparte: PHP genera ese archivo SIN punto antes de
# "log" (no "error.log"), así que nunca coincidía con \.(txt|json|log|sql|md)$
# — quedaba descargable con rutas absolutas del servidor y detalles de
# esquema de BD en los stack traces.
<FilesMatch "(\.(txt|json|log|sql|md)$|^error_log$)">
    Require all denied
</FilesMatch>

<Files "config.php">
    Require all denied
</Files>
<Files "db.php">
    Require all denied
</Files>

# CSP: mitiga XSS restringiendo de dónde puede cargar/ejecutar recursos la
# página. script-src NO incluye 'unsafe-inline' — el único script inline que
# había (la animación de bienvenida) se movió a assets/js/intro-splash.js
# para que esto pudiera ser estricto de verdad. style-src sí necesita
# 'unsafe-inline' por el bloque <style> de esa misma animación.
<IfModule mod_headers.c>
    # img-src: se abre a cualquier https porque las fotos de alumnos y tutores,
    # y el logo del colegio, se guardan como enlaces externos (Drive, Dropbox,
    # OneDrive...). Restringirlo a una lista fija haria que un tutor que pega
    # un enlace de otro servicio vea la imagen rota sin explicacion.
    # Una imagen no ejecuta codigo, y script-src sigue estricto (sin
    # 'unsafe-inline'), asi que el riesgo real de esta apertura es bajo.
    # Si prefieres cerrarlo, sustituye "https:" por los hosts que uses:
    #   https://drive.google.com https://*.googleusercontent.com
    #
    # frame-src: hacia falta para el reproductor de los tutoriales del portal
    # de distribuidores. Sin esta directiva caia en default-src 'self' y el
    # video quedaba bloqueado.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: ; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # El shell (index.html) referencia las vistas/JS con "?v=timestamp" para
    # forzar la descarga de la versión nueva en cada deploy — pero eso solo
    # funciona si el navegador vuelve a pedir index.html. Sin este header,
    # algunos navegadores lo sirven de caché por horas incluso con Ctrl+F5
    # en ciertas condiciones, y entonces cargan las vistas/JS VIEJAS (viejos
    # "?v=") indefinidamente, aunque el deploy en el servidor ya esté al día.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ── RENDIMIENTO (25-sep-2026) ─────────────────────────────────────────────
# Diagnóstico: index.html cuelga 59 archivos .js (1.37 MB sin minificar) más
# main.css (69 KB). Ninguno tenía política de caché NI compresión, así que
# cada recarga los revalidaba uno por uno contra el servidor. Esa es la causa
# dominante de "cuando recargo la página tarda demasiado".
<IfModule mod_deflate.c>
    # Solo tipos de texto. Nada de imágenes/PDF: ya vienen comprimidos y
    # volver a comprimirlos gasta CPU sin ganar bytes. application/json entra
    # a propósito: son las respuestas de api.php.
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché larga para JS/CSS. Es SEGURO pese a lo agresivo que parece: index.html
# referencia cada archivo con "?v=<timestamp>" y él mismo nunca se cachea (ver
# el FilesMatch de index.html más arriba). Al desplegar cambia el "?v=", la URL
# pasa a ser otra, y el navegador la baja de nuevo.
#
# OJO, la otra cara: esto vuelve OBLIGATORIO subir el "?v=" de todo archivo que
# cambies. Si lo olvidas, el navegador se queda con la versión vieja hasta que
# el usuario haga Ctrl+F5. Por eso NO se usa "immutable": sin esa palabra, una
# recarga forzada todavía puede revalidar y rescatar al usuario.
<IfModule mod_expires.c>
    ExpiresActive On
    # Sin ExpiresDefault a propósito: text/html NUNCA debe caer aquí, o
    # index.html empezaría a cachearse y rompería el "?v=".
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript        "access plus 1 year"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

# Respaldo por si mod_expires no está cargado (Hostinger corre LiteSpeed, que
# emula estos módulos pero no siempre anuncia los dos). mod_headers sí está:
# lo usa la CSP de más arriba, que sabemos que funciona en producción.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
